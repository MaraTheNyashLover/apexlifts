{
  "appId": "com.gymtitles.app",
  "appName": "Apex Lifts",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0F1012",
    "preferredContentMode": "mobile",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#0F1012",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0F1012"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "Keyboard": {
      "resize": "body"
    }
  }
}